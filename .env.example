# StudyMate AI Configuration
# Get your free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000

# ==============================================================================
# Firebase Client Configuration (Optional: Can also be set in firebase-config.js)
# Obtain from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ==============================================================================
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ==============================================================================
# Firebase Admin SDK Configuration (for server token verification)
# Obtain from: Firebase Console -> Project Settings -> Service Accounts -> Generate Private Key
# ==============================================================================
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternatively, specify path to serviceAccountKey.json:
# FIREBASE_SERVICE_ACCOUNT_KEY=./server/serviceAccountKey.json

